{
  "name": "amparo-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "quality": "node tools/quality.mjs",
    "build": "node tools/package-demo.mjs",
    "data:catalog": "node data/cli.mjs catalog",
    "data:ingest": "node data/cli.mjs ingest",
    "data:status": "node data/cli.mjs status",
    "data:query": "node data/cli.mjs query",
    "data:serve": "node data/cli.mjs serve",
    "data:cli": "node data/cli.mjs",
    "data:verify": "node tools/verify-data.mjs",
    "news:export": "node tools/export-news.mjs",
    "build:auth-sdk": "node tools/build-auth-sdk.mjs",
    "ios:prepare": "node tools/build-ios.mjs && cap sync ios && node tools/configure-ios.mjs",
    "ios:open": "cap open ios",
    "ios:release-check": "node tools/check-ios-release.mjs",
    "ios:release-prepare": "npm run ios:release-check && npm run ios:prepare"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "plist": "3.1.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "xcode": "3.0.1"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@supabase/supabase-js": "2.118.0",
    "fast-xml-parser": "5.11.2",
    "jsonc-parser": "3.3.1",
    "leaflet": "1.9.4",
    "stripe": "23.0.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
